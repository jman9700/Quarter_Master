-- A kind of product ("Great Value Whole Milk, 1 gal"). Formerly a line in lookup.txt.
--
-- Sync-ready conventions used by every table:
--   * ids are random UUIDs, so rows created on different devices never collide
--   * created_at / updated_at are epoch milliseconds; updated_at drives last-write-wins merges
--   * rows are never hard-deleted; deleted_at is a tombstone that a future server can sync
CREATE TABLE product_type (
    id            TEXT    NOT NULL PRIMARY KEY,
    gtin          TEXT,              -- normalized GTIN-14, NULL for products without a barcode (e.g. fruit)
    name          TEXT    NOT NULL,
    lifespan_days INTEGER NOT NULL,  -- default shelf life after it is added
    quantity      REAL    NOT NULL,
    unit          TEXT    NOT NULL,
    image_file    TEXT,              -- file name inside the app's image store
    created_at    INTEGER NOT NULL,
    updated_at    INTEGER NOT NULL,
    deleted_at    INTEGER,
    -- Fields the user typed or chose themselves (comma list of name, amount, image).
    -- An online lookup never overwrites these.
    user_fields         TEXT    NOT NULL DEFAULT '',
    -- NONE (never looked up) | PENDING (queued until online) | FOUND | NOT_FOUND
    lookup_status       TEXT    NOT NULL DEFAULT 'NONE',
    lookup_requested_at INTEGER,
    nutrition           TEXT              -- JSON, see domain/Nutrition.kt
);

CREATE UNIQUE INDEX product_type_active_gtin ON product_type(gtin) WHERE gtin IS NOT NULL AND deleted_at IS NULL;

selectActive:
SELECT * FROM product_type WHERE deleted_at IS NULL ORDER BY name COLLATE NOCASE;

selectById:
SELECT * FROM product_type WHERE id = ?;

selectActiveByGtin:
SELECT * FROM product_type WHERE gtin = ? AND deleted_at IS NULL;

selectAll:
SELECT * FROM product_type;

insert:
INSERT INTO product_type(id, gtin, name, lifespan_days, quantity, unit, image_file, created_at, updated_at, deleted_at,
                         user_fields, lookup_status, lookup_requested_at, nutrition)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE product_type
SET gtin = ?, name = ?, lifespan_days = ?, quantity = ?, unit = ?, image_file = ?, user_fields = ?, updated_at = ?
WHERE id = ?;

setLifespan:
UPDATE product_type SET lifespan_days = ?, updated_at = ? WHERE id = ?;

-- Lookup queue: products waiting for the food database, oldest request first.
selectPendingLookups:
SELECT * FROM product_type WHERE lookup_status = 'PENDING' AND deleted_at IS NULL ORDER BY lookup_requested_at;

setLookupState:
UPDATE product_type SET lookup_status = ?, lookup_requested_at = ?, nutrition = ? WHERE id = ?;

-- Products with a barcode that were never looked up (created with lookup turned off, or before nutrition existed).
queueNeverLookedUp:
UPDATE product_type SET lookup_status = 'PENDING', lookup_requested_at = :now
WHERE lookup_status = 'NONE' AND gtin IS NOT NULL AND deleted_at IS NULL;

applyLookup:
UPDATE product_type
SET name = ?, quantity = ?, unit = ?, image_file = ?, nutrition = ?, lookup_status = 'FOUND', lookup_requested_at = NULL, updated_at = ?
WHERE id = ?;

-- Used by backup import to apply a newer remote copy of a row, tombstone included.
replace:
UPDATE product_type
SET gtin = ?, name = ?, lifespan_days = ?, quantity = ?, unit = ?, image_file = ?,
    created_at = ?, updated_at = ?, deleted_at = ?,
    user_fields = ?, lookup_status = ?, lookup_requested_at = ?, nutrition = ?
WHERE id = ?;

softDelete:
UPDATE product_type SET deleted_at = :now, updated_at = :now WHERE id = :id;
